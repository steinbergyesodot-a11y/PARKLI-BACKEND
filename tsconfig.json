{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "src",
    "outDir": "dist",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "typeRoots": ["./node_modules/@types"] 
    // ^ Remove "types" and add "typeRoots" instead
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}